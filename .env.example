# Copie para ".env" (o .env NÃO vai para o Git nem para a pasta public).
# Em hospedagens (Render, Railway, VPS…), defina estas variáveis no painel em vez de usar .env.

PORT=3000

# Provedor de anúncios:
#   lootlabs -> (padrão) o botão leva ao link do LootLabs definido em "lootlabsUrl" no config/versions.json.
#   test     -> modo de teste do anúncio com recompensa. Anúncio falso, sem conta de anúncios.
#   gpt      -> Google Ad Manager, anúncio com recompensa na web (GPT rewarded).
#   none     -> sem anúncios: o botão baixa direto.
AD_PROVIDER=lootlabs

# Permite que o visitante pule a oferta e baixe sem assistir (true/false).
AD_ALLOW_SKIP=false

# Tempo máximo (ms) esperando o provedor ter um anúncio pronto antes de liberar o download direto.
AD_LOAD_TIMEOUT_MS=10000

# --- Google Ad Manager (AD_PROVIDER=gpt) ---
# Caminho do bloco de anúncios "Rewarded" criado no Ad Manager, ex.: /1234567/voltix_rewarded
GPT_AD_UNIT_PATH=

# --- Provedor com verificação no servidor (SSV) ---
# Segredo/chave usado para validar o callback do provedor. Nunca coloque isto em /public.
AD_SSV_SECRET=
